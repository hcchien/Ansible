{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elix.cool/contracts/identity-resolution/v1/board.schema.json",
  "title": "Elix Board Identity",
  "type": "object",
  "required": ["id", "slug", "legacy_ids"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "minLength": 1 },
    "legacy_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}
