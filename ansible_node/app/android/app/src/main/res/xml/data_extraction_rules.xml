<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="RemoteMirrorCache/" />
        <!-- Exclude the SQLite database to prevent leaking messenger metadata,
             session state, and pre-key references via cloud backup. -->
        <exclude domain="database" path="ansible.db" />
        <exclude domain="database" path="ansible.db-shm" />
        <exclude domain="database" path="ansible.db-wal" />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="RemoteMirrorCache/" />
        <exclude domain="database" path="ansible.db" />
        <exclude domain="database" path="ansible.db-shm" />
        <exclude domain="database" path="ansible.db-wal" />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
