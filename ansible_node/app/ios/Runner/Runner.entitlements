<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.nfc.readersession.formats</key>
	<array>
		<string>TAG</string>
	</array>
	<!-- Universal links (outbound sharing loop): lets iOS open
	     https://<share-host>/boards/... directly in the app. Each listed host
	     must serve /.well-known/apple-app-site-association (relay + web frontend
	     both do, gated on UNIVERSAL_LINK_IOS_APP_IDS). Requires the Associated
	     Domains capability on the App ID (automatic signing adds it). -->
	<!-- APNS wake pushes (notification system Phase B). Xcode/signing swaps
	     this to "production" for App Store / TestFlight builds. -->
	<key>aps-environment</key>
	<string>development</string>
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:relay-dev.elix.cool</string>
		<string>applinks:relay.elix.cool</string>
		<string>applinks:forum.elix.cool</string>
		<string>applinks:dev.elix.cool</string>
		<string>applinks:elix.cool</string>
		<string>webcredentials:dev.elix.cool</string>
		<string>webcredentials:elix.cool</string>
	</array>
</dict>
</plist>
