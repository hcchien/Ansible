<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Elix</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>zh-Hant</string>
		<string>fr</string>
		<string>es</string>
		<string>ja</string>
		<string>ko</string>
		<string>de</string>
		<string>it</string>
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Elix</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- Content-free wake pushes (apns-push-type: background) need the
	     remote-notification background mode; the relay only ever sends
	     {"hint":"sync"} and the app composes local notifications itself. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>io.trisaura.elix.mobilemoica</string>
			<!-- The trisaura:// scheme also carries shared-content deep links
			     (trisaura://content/boards/:id[/threads/:tid]); see
			     lib/services/elix_content_link.dart + lib/main.dart. -->
			<key>CFBundleURLSchemes</key>
			<array>
				<string>trisaura</string>
			</array>
		</dict>
	</array>
	<!-- TODO(universal links): to make plain https://<share-host>/boards/...
	     links open the app directly (iOS Universal Links), add the
	     com.apple.developer.associated-domains entitlement
	     (applinks:<share-host>) to Runner.entitlements and publish
	     /.well-known/apple-app-site-association on that host mapping
	     /boards/* to this app's <TeamID>.<bundle-id>. In-app routing already
	     accepts https content links (ElixContentLink), so only the OS
	     association files remain. -->

	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>mobilemoica</string>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NFCReaderUsageDescription</key>
	<string>Elix uses NFC to read the ePassport chip for identity anchoring.</string>
	<key>NSCameraUsageDescription</key>
	<string>Elix uses the camera to scan verifier QR requests before presenting wallet credentials.</string>
	<!-- App Transport Security.
	     NSAllowsLocalNetworking permits plaintext HTTP to LAN/loopback hosts.
	     It is required ONLY by the staging build (scripts/install_ios_staging_release.sh),
	     which points the app at a LAN-IP relay over http:// for on-device QA.
	     A production build talks to a remote HTTPS relay/issuer (see
	     lib/config/app_environment.dart) and does NOT need this key — for a
	     store submission, remove the NSAppTransportSecurity dict below (and the
	     NSLocalNetworkUsageDescription string) so ATS enforces HTTPS-only, and
	     NEVER add NSAllowsArbitraryLoads. It is left enabled here because this
	     shared plist currently drives the staging QA build. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Shown when the app first accesses the local network. Kept
	     App-Store-appropriate (no "development" wording) since the same plist is
	     reused for release builds. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Elix uses the local network to reach your Elix relay on the same Wi-Fi network.</string>
	<key>com.apple.developer.nfc.readersession.iso7816.select-identifiers</key>
	<array>
		<string>A0000002471001</string>
		<string>A0000002472001</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
</dict>
</plist>
